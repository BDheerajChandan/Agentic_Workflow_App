  "workflow_backend": {
    "id": "workflow_backend",
    "name": "workflow_backend",
    "path": "../Workflow_App/backend",
    "description": "",
    "enabled": true,
    "services": {
      "backend": {
        "id": "workflow_backend",
        "name": "workflow_backend",
        "type": "backend",
        "path": "../Workflow_App/backend",
        "runtime": "python",
        "host": "localhost",
        "bind_address": "127.0.0.1",
